{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apievangelist.com/amazon-kms/key-definition",
  "title": "Amazon KMS Key Definition",
  "description": "Schema defining the structure of an AWS KMS key resource, including key metadata, usage, spec, state, rotation configuration, and associated policies and grants.",
  "type": "object",
  "required": [
    "keyId"
  ],
  "properties": {
    "keyId": {
      "type": "string",
      "description": "The globally unique identifier for the KMS key."
    },
    "arn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the KMS key."
    },
    "description": {
      "type": "string",
      "description": "A description of the KMS key."
    },
    "keyUsage": {
      "type": "string",
      "enum": [
        "SIGN_VERIFY",
        "ENCRYPT_DECRYPT",
        "GENERATE_VERIFY_MAC"
      ],
      "description": "The cryptographic operations for which you can use the key."
    },
    "keySpec": {
      "type": "string",
      "enum": [
        "SYMMETRIC_DEFAULT",
        "RSA_2048",
        "RSA_3072",
        "RSA_4096",
        "ECC_NIST_P256",
        "ECC_NIST_P384",
        "ECC_NIST_P521",
        "ECC_SECG_P256K1",
        "HMAC_224",
        "HMAC_256",
        "HMAC_384",
        "HMAC_512"
      ],
      "description": "The type of key material in the KMS key."
    },
    "keyState": {
      "type": "string",
      "enum": [
        "Creating",
        "Enabled",
        "Disabled",
        "PendingDeletion",
        "PendingImport",
        "PendingReplicaDeletion",
        "Unavailable",
        "Updating"
      ],
      "description": "The current state of the KMS key."
    },
    "origin": {
      "type": "string",
      "enum": [
        "AWS_KMS",
        "EXTERNAL",
        "AWS_CLOUDHSM",
        "EXTERNAL_KEY_STORE"
      ],
      "description": "The source of the key material."
    },
    "keyManager": {
      "type": "string",
      "enum": [
        "AWS",
        "CUSTOMER"
      ],
      "description": "The manager of the KMS key."
    },
    "customerMasterKeySpec": {
      "type": "string",
      "description": "Deprecated. Use keySpec instead."
    },
    "encryptionAlgorithms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYMMETRIC_DEFAULT",
          "RSAES_OAEP_SHA_1",
          "RSAES_OAEP_SHA_256",
          "SM2PKE"
        ]
      },
      "description": "The encryption algorithms supported by the key."
    },
    "signingAlgorithms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The signing algorithms supported by the key."
    },
    "multiRegion": {
      "type": "boolean",
      "description": "Whether the key is a multi-Region key."
    },
    "multiRegionConfiguration": {
      "type": "object",
      "properties": {
        "multiRegionKeyType": {
          "type": "string",
          "enum": [
            "PRIMARY",
            "REPLICA"
          ]
        },
        "primaryKey": {
          "type": "object",
          "properties": {
            "arn": {
              "type": "string"
            },
            "region": {
              "type": "string"
            }
          }
        },
        "replicaKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "arn": {
                "type": "string"
              },
              "region": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Multi-Region key configuration."
    },
    "creationDate": {
      "type": "string",
      "format": "date-time",
      "description": "The date the key was created."
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether the key is enabled."
    },
    "expirationModel": {
      "type": "string",
      "enum": [
        "KEY_MATERIAL_EXPIRES",
        "KEY_MATERIAL_DOES_NOT_EXPIRE"
      ],
      "description": "Whether the key material expires."
    },
    "deletionDate": {
      "type": "string",
      "format": "date-time",
      "description": "The date the key is scheduled for deletion."
    },
    "rotationEnabled": {
      "type": "boolean",
      "description": "Whether automatic key rotation is enabled."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "TagKey": {
            "type": "string"
          },
          "TagValue": {
            "type": "string"
          }
        }
      },
      "description": "Tags associated with the KMS key."
    },
    "policy": {
      "type": "string",
      "description": "The key policy document in JSON format."
    }
  }
}
